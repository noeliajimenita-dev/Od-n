# ==========================================
# THE ODIN PROJECT - ENVIRONMENT TEMPLATE
# ==========================================

# =========================
# APPLICATION
# =========================

APP_NAME=THE_ODIN_PROJECT
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# =========================
# AI PROVIDERS
# =========================

# Gemini
GEMINI_API_KEY=

# Groq
GROQ_API_KEY=

# =========================
# TELEGRAM
# =========================

# Supervisor
TELEGRAM_SUPERVISOR_BOT_TOKEN=

# Worker 1
TELEGRAM_WORKER_1_BOT_TOKEN=

# Worker 2
TELEGRAM_WORKER_2_BOT_TOKEN=

# Worker 3
TELEGRAM_WORKER_3_BOT_TOKEN=

# Worker 4
TELEGRAM_WORKER_4_BOT_TOKEN=

# Worker 5
TELEGRAM_WORKER_5_BOT_TOKEN=

# =========================
# GITHUB
# =========================

GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_MAIN_BRANCH=main

# =========================
# RESOURCE LIMITS
# =========================

DAILY_TOKEN_LIMIT=
MONTHLY_TOKEN_LIMIT=
SAFETY_RESERVE_PERCENT=10

# Alert thresholds
RESOURCE_ALERT_50=true
RESOURCE_ALERT_75=true
RESOURCE_ALERT_90=true
RESOURCE_ALERT_100=true

# =========================
# SYSTEM CONTROL
# =========================

STOP_ALL_ENABLED=true
HUMAN_APPROVAL_REQUIRED=true
PROTECTED_MAIN=true
AUDIT_LOG_ENABLED=true
BACKUP_BEFORE_CHANGES=true

# =========================
# FUTURE ORACLE CLOUD
# =========================

ORACLE_HOST=
ORACLE_USERNAME=
ORACLE_SSH_KEY_PATH=
